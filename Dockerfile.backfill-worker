# ---- Builder Stage: install Python dependencies ----
FROM python:3.12-slim AS builder

WORKDIR /app

# Install dependencies into an isolated virtual environment.
# All packages ship pre-built wheels — no system build tools needed.
COPY requirements.txt .
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt


# ---- Runtime Stage: minimal production image ----
FROM python:3.12-slim AS runtime

# Create a non-root user for the application process.
RUN groupadd --system gateway && \
    useradd --system --no-log-init --gid gateway --create-home gateway

# Copy the virtual environment from the builder stage.
COPY --from=builder /opt/venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# The backfill worker needs the full app/ package, the pure-domain
# afk_outcomes/ package, and the backfill engine (scripts/afk_backfill.py)
# whose run_backfill orchestration it executes for queued jobs.
COPY app/ /app/app/
COPY afk_outcomes/ /app/afk_outcomes/
COPY scripts/afk_backfill.py /app/scripts/afk_backfill.py

# Switch to the non-root gateway user.
USER gateway

# Verify the worker can be imported at build time.
RUN python -c "import app.backfill.worker; print('Backfill worker module ready')"

# Health check: use a Python probe that verifies PID 1 is alive and is the
# backfill worker process (exec-form CMD makes the worker PID 1 by
# construction).  The probe command must stay identical to the k8s
# livenessProbe exec command in k8s/backfill-worker-deployment.yaml.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os,sys; os.kill(1,0); sys.exit(0 if b'app.backfill.worker' in open('/proc/1/cmdline','rb').read() else 1)"]

CMD ["python", "-m", "app.backfill.worker"]

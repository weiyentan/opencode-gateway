# OpenCode Gateway Observability Service Configuration
#
# Copy to .env and adjust for your environment.
# All values shown are the defaults.

# Deployment environment: "production" (default) or "development"
# Production requires an API key (GATEWAY_API_KEY).  Development allows
# running without one for local convenience.
# GATEWAY_ENV=production

# API authentication key (required in production mode)
# Requests must include an Authorization: Bearer <api-key> header.
# GATEWAY_API_KEY=

# Explicit insecure-auth opt-in.  When set to "true", the Gateway starts
# without an API key even in production mode and logs a loud warning.
# Prefer GATEWAY_ENV=development for local work.
# GATEWAY_ALLOW_INSECURE_AUTH=false

# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Database
GATEWAY_DATABASE_HOST=localhost
GATEWAY_DATABASE_PORT=5432
GATEWAY_DATABASE_NAME=opencode_gateway
GATEWAY_DATABASE_USER=opencode
GATEWAY_DATABASE_PASSWORD=
GATEWAY_DATABASE_MIN_CONNECTIONS=2
GATEWAY_DATABASE_MAX_CONNECTIONS=10
GATEWAY_DATABASE_CONNECTION_TIMEOUT=30
GATEWAY_DATABASE_MAX_INACTIVE_CONNECTION_LIFETIME=1800

# Timeout budgets (seconds) for layered request processing
#   database: per-query timeout via asyncio.timeout
#   status_computation: _compute_status timeout
#   total_request: endpoint-level total budget
GATEWAY_DATABASE_TIMEOUT_SECONDS=5
GATEWAY_STATUS_COMPUTATION_TIMEOUT_SECONDS=2
GATEWAY_TOTAL_REQUEST_TIMEOUT_SECONDS=20

# Agent run status derivation thresholds (issue #300)
#   quiet:  last message within this window -> "running"
#   stale:  quiet beyond this (but within unknown) -> "stale"
#   unknown: quiet beyond this -> "unknown"
GATEWAY_QUIET_THRESHOLD_MINUTES=15
GATEWAY_STALE_THRESHOLD_HOURS=2
GATEWAY_UNKNOWN_THRESHOLD_HOURS=48

# Default per-operation timeout budget (milliseconds) used by the telemetry
# module when an operation specifies no explicit budget. Read directly by
# app/core/telemetry.py (not via pydantic settings).
GATEWAY_OPERATION_TIMEOUT_MS=30000

# Grafana / Loki
GATEWAY_GRAFANA_BASE_URL=http://localhost:3000

# Validation detail logging (off by default)
# When set to "true", the ingest endpoint logs structured field-level
# validation details for every 422 validation failure.  Field values are
# passed through the existing secret-redaction path, but the pattern
# matcher may not catch all sensitive information embedded in arbitrary
# field values.  Evaluate your collector payloads before enabling this
# in production.
# GATEWAY_LOG_VALIDATION_DETAIL=false

# Frontend dashboard static files directory
# Path to the Aurora Glass telemetry dashboard SPA assets.
# GATEWAY_STATIC_DIR=frontend

# Kafka consumer — bridges usage records from Kafka to the Gateway ingest API.
# The consumer is a separate container that reads from the ``opencode-usage``
# topic and POSTs to ``{GATEWAY_BASE_URL}/ingest``.
# GATEWAY_KAFKA_BROKERS=localhost:9092
# GATEWAY_KAFKA_TOPIC=opencode-usage
# GATEWAY_KAFKA_DLQ_TOPIC=opencode-usage-dlq
# GATEWAY_CONSUMER_GROUP_ID=opencode-gateway
# GATEWAY_BASE_URL=http://localhost:8000
# GATEWAY_COLLECTOR_TOKEN=

# AFK outcome consumer (issue #451) — live ingestion for AFK Outcome
# Observability.  Runs in its OWN Kafka consumer group (``opencode-outcomes``,
# never the usage consumer's ``opencode-gateway`` group), consumes the
# external provider-events topic, and reconciles terminal states over a
# bounded window reusing the backfill engine.
# GATEWAY_AFK_OUTCOMES_TOPIC=afk.events
# GATEWAY_AFK_OUTCOMES_DLQ_TOPIC=afk.events-dlq
# GATEWAY_AFK_OUTCOMES_CONSUMER_GROUP_ID=opencode-outcomes
# GATEWAY_AFK_OUTCOMES_PROVIDER=github
# Enable the AFK outcome consumer config guard: the Settings validator fails
# fast at startup when GATEWAY_AFK_OUTCOMES_REPOSITORY is empty.  The
# consumer container sets this to true in the docker-compose/k8s manifests;
# the read-only Gateway API process does not need it.
# GATEWAY_AFK_OUTCOMES_CONSUMER_ENABLED=true
# REQUIRED for the consumer: the owner/repo (e.g. "acme/backend") the
# scheduled reconciliation reconciles against.  Leave it empty and the
# consumer fails fast at startup instead of silently retrying forever.
# GATEWAY_AFK_OUTCOMES_REPOSITORY=
# GATEWAY_AFK_OUTCOMES_RECONCILE_CADENCE_SECONDS=3600
# GATEWAY_AFK_OUTCOMES_RECONCILE_WINDOW_SECONDS=86400

# Execution-transcript truncation caps (issue #465 / ADR 0016)
# Applied at ingest before any message/part/tool payload reaches the
# durable store.
#   tool payload: per-field cap on observed_tool_calls.tool_input/tool_output
#   part data:    verbatim cap on observed_messages.data / observed_parts.data,
#                 stored with a "truncated" marker when content is cut
GATEWAY_TOOL_PAYLOAD_MAX_CHARS=4096
GATEWAY_PART_DATA_MAX_CHARS=65536

# Execution-transcript retention (issue #470) — per-table retention windows
# (days) for the append-only transcript tables (observed_messages /
# observed_parts / observed_tool_calls), enforced by
# scripts/retention_transcripts.py on a schedule.  Transcript data is
# higher-volume and lower-longevity than accounting data: parts and tool
# calls default to 90 days while messages (the session reconstruction
# surface) keep a longer 365-day window.  Retention is keyed on the
# transcript timestamps (source_created_at_tz), never ingest time.
# Accounting aggregates (usage events, rollup) keep their existing, longer
# retention and are never touched by the job.
# GATEWAY_TRANSCRIPT_RETENTION_MESSAGES_DAYS=365
# GATEWAY_TRANSCRIPT_RETENTION_PARTS_DAYS=90
# GATEWAY_TRANSCRIPT_RETENTION_TOOL_CALLS_DAYS=90

# ==============================================================
# Docker Compose (used by docker-compose.yaml)
# ==============================================================
# These variables configure the bundled PostgreSQL container.
# The gateway service reads GATEWAY_DATABASE_*; the postgres
# service reads POSTGRES_*.  docker-compose.yaml wires them
# together via the defaults shown below.

# PostgreSQL superuser and database name
POSTGRES_USER=opencode
POSTGRES_PASSWORD=opencode
POSTGRES_DB=opencode_gateway
